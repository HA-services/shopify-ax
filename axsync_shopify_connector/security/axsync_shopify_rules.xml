<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_axsync_shopify_store_company" model="ir.rule">
            <field name="name">Shopify store: company</field>
            <field name="model_id" ref="model_axsync_shopify_store"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_axsync_shopify_queue_company" model="ir.rule">
            <field name="name">Shopify queue: company</field>
            <field name="model_id" ref="model_axsync_shopify_queue"/>
            <field name="domain_force">[('store_id.company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_axsync_shopify_log_company" model="ir.rule">
            <field name="name">Shopify log: company</field>
            <field name="model_id" ref="model_axsync_shopify_log"/>
            <field name="domain_force">['|', ('store_id', '=', False), ('store_id.company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_axsync_shopify_product_company" model="ir.rule">
            <field name="name">Shopify product: company</field>
            <field name="model_id" ref="model_axsync_shopify_product"/>
            <field name="domain_force">[('store_id.company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_axsync_shopify_customer_company" model="ir.rule">
            <field name="name">Shopify customer: company</field>
            <field name="model_id" ref="model_axsync_shopify_customer"/>
            <field name="domain_force">[('store_id.company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
