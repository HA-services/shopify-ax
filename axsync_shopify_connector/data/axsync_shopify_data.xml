<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="product_shopify_shipping" model="product.product">
            <field name="name">Shopify shipping</field>
            <field name="type">service</field>
            <field name="list_price">0.0</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="default_code">SHOPIFY-SHIP</field>
        </record>
        <record id="product_shopify_discount" model="product.product">
            <field name="name">Shopify adjustment</field>
            <field name="type">service</field>
            <field name="list_price">0.0</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="default_code">SHOPIFY-ADJ</field>
        </record>
    </data>
</odoo>
