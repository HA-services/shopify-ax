<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sales order -->
    <record id="view_order_form_axsync_shopify" model="ir.ui.view">
        <field name="name">sale.order.form.axsync.shopify</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_in_shopify" string="Open in Shopify" type="object" invisible="not shopify_store_id"/>
                <button name="action_resync_shopify" string="Refresh from Shopify" type="object" invisible="not shopify_store_id"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Shopify" name="shopify" invisible="not shopify_store_id">
                    <group>
                        <group>
                            <field name="shopify_store_id"/>
                            <field name="shopify_order_name"/>
                            <field name="shopify_order_id"/>
                            <field name="shopify_currency"/>
                        </group>
                        <group>
                            <field name="shopify_financial_status"/>
                            <field name="shopify_fulfillment_status"/>
                            <field name="shopify_gateway"/>
                            <field name="shopify_tags"/>
                            <field name="shopify_cancelled"/>
                        </group>
                    </group>
                    <group string="Problem" invisible="not shopify_error">
                        <field name="shopify_error" nolabel="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_axsync_shopify" model="ir.ui.view">
        <field name="name">sale.order.search.axsync.shopify</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="shopify_order_name"/>
                <filter name="shopify_orders" string="Shopify orders" domain="[('shopify_store_id', '!=', False)]"/>
                <filter name="shopify_unpaid" string="Shopify: not paid" domain="[('shopify_store_id', '!=', False), ('shopify_financial_status', 'in', ('pending', 'authorized', 'partially_paid'))]"/>
                <filter name="shopify_problem" string="Shopify: has a problem" domain="[('shopify_error', '!=', False)]"/>
                <filter name="group_shopify_store" string="Shopify store" context="{'group_by': 'shopify_store_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_axsync_shopify_order_tree" model="ir.ui.view">
        <field name="name">axsync.shopify.order.tree</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list create="0" decoration-muted="state == 'cancel'" decoration-danger="shopify_error != False">
                <field name="name"/>
                <field name="shopify_order_name"/>
                <field name="shopify_store_id"/>
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="shopify_financial_status" widget="badge"/>
                <field name="shopify_fulfillment_status" widget="badge"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" invisible="1"/>
                <field name="shopify_error" invisible="1"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_axsync_shopify_order_pivot" model="ir.ui.view">
        <field name="name">axsync.shopify.order.pivot</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="shopify_store_id" type="row"/>
                <field name="date_order" interval="month" type="col"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_axsync_shopify_order_graph" model="ir.ui.view">
        <field name="name">axsync.shopify.order.graph</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="date_order" interval="week"/>
                <field name="shopify_store_id"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_axsync_shopify_orders" model="ir.actions.act_window">
        <field name="name">Shopify orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="domain">[('shopify_store_id', '!=', False)]</field>
        <field name="search_view_id" ref="sale.view_sales_order_filter"/>
        <field name="context">{'create': False}</field>
    </record>
    <record id="action_axsync_shopify_orders_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_axsync_shopify_order_tree"/>
        <field name="act_window_id" ref="action_axsync_shopify_orders"/>
    </record>
    <record id="action_axsync_shopify_orders_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_axsync_shopify_order_pivot"/>
        <field name="act_window_id" ref="action_axsync_shopify_orders"/>
    </record>
    <record id="action_axsync_shopify_orders_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_axsync_shopify_order_graph"/>
        <field name="act_window_id" ref="action_axsync_shopify_orders"/>
    </record>

    <!-- Delivery -->
    <record id="view_picking_form_axsync_shopify" model="ir.ui.view">
        <field name="name">stock.picking.form.axsync.shopify</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_tracking_to_shopify" string="Send to Shopify" type="object"
                        invisible="not shopify_store_id or state != 'done' or shopify_sent"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Shopify" name="shopify" invisible="not shopify_store_id">
                    <group>
                        <group>
                            <field name="shopify_store_id"/>
                            <field name="shopify_tracking_number"/>
                            <field name="shopify_tracking_company"/>
                            <field name="shopify_tracking_url" widget="url"/>
                        </group>
                        <group>
                            <field name="shopify_sent"/>
                            <field name="shopify_sent_date"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Product -->
    <record id="product_template_form_axsync_shopify" model="ir.ui.view">
        <field name="name">product.template.form.axsync.shopify</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Shopify" name="shopify">
                    <group>
                        <group>
                            <field name="shopify_exclude"/>
                            <field name="shopify_publish" invisible="shopify_exclude"/>
                            <field name="shopify_vendor" invisible="shopify_exclude"/>
                            <field name="shopify_product_type" invisible="shopify_exclude"/>
                            <field name="shopify_tags" invisible="shopify_exclude"/>
                        </group>
                        <group string="Search engines" invisible="shopify_exclude">
                            <field name="shopify_seo_title"/>
                            <field name="shopify_seo_description"/>
                        </group>
                    </group>
                    <field name="shopify_product_ids" invisible="shopify_exclude">
                        <list create="0" edit="0">
                            <field name="store_id"/>
                            <field name="state"/>
                            <field name="handle"/>
                            <field name="last_export"/>
                            <field name="last_import"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_server_axsync_shopify_export_products" model="ir.actions.server">
        <field name="name">Export to Shopify</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records.action_export_to_shopify()</field>
    </record>

    <!-- Partner -->
    <record id="view_partner_form_axsync_shopify" model="ir.ui.view">
        <field name="name">res.partner.form.axsync.shopify</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Shopify" name="shopify" invisible="not shopify_customer_ids">
                    <field name="shopify_customer_ids">
                        <list create="0" edit="0">
                            <field name="store_id"/>
                            <field name="email"/>
                            <field name="shopify_id"/>
                            <field name="last_sync"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
