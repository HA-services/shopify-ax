<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Queue -->
    <record id="view_axsync_shopify_queue_tree" model="ir.ui.view">
        <field name="name">axsync.shopify.queue.tree</field>
        <field name="model">axsync.shopify.queue</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'dead'" decoration-warning="state == 'failed'" decoration-muted="state == 'done'">
                <header>
                    <button name="action_retry" string="Retry" type="object"/>
                    <button name="action_run_now" string="Run now" type="object"/>
                </header>
                <field name="create_date"/>
                <field name="store_id"/>
                <field name="kind"/>
                <field name="topic"/>
                <field name="shopify_id"/>
                <field name="state" widget="badge"/>
                <field name="attempts"/>
                <field name="error"/>
            </list>
        </field>
    </record>
    <record id="view_axsync_shopify_queue_form" model="ir.ui.view">
        <field name="name">axsync.shopify.queue.form</field>
        <field name="model">axsync.shopify.queue</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_run_now" string="Run now" type="object" class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_retry" string="Retry" type="object" invisible="state not in ('dead', 'failed')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="store_id"/>
                            <field name="kind"/>
                            <field name="topic"/>
                            <field name="shopify_id"/>
                            <field name="webhook_id"/>
                        </group>
                        <group>
                            <field name="attempts"/>
                            <field name="next_try"/>
                            <field name="done_date"/>
                        </group>
                    </group>
                    <group string="Error"><field name="error" nolabel="1"/></group>
                    <group string="Payload"><field name="payload" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_axsync_shopify_queue_search" model="ir.ui.view">
        <field name="name">axsync.shopify.queue.search</field>
        <field name="model">axsync.shopify.queue</field>
        <field name="arch" type="xml">
            <search>
                <field name="shopify_id"/>
                <field name="store_id"/>
                <field name="topic"/>
                <filter name="waiting" string="Waiting" domain="[('state', 'in', ('pending', 'failed'))]"/>
                <filter name="dead" string="Gave up" domain="[('state', '=', 'dead')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                
                    <filter name="g_store" string="Store" context="{'group_by': 'store_id'}"/>
                    <filter name="g_kind" string="Kind" context="{'group_by': 'kind'}"/>
                    <filter name="g_state" string="State" context="{'group_by': 'state'}"/>
                
            </search>
        </field>
    </record>
    <record id="action_axsync_shopify_queue" model="ir.actions.act_window">
        <field name="name">Queue</field>
        <field name="res_model">axsync.shopify.queue</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_waiting': 1}</field>
    </record>

    <!-- Log -->
    <record id="view_axsync_shopify_log_tree" model="ir.ui.view">
        <field name="name">axsync.shopify.log.tree</field>
        <field name="model">axsync.shopify.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="level == 'error'" decoration-warning="level == 'warning'">
                <field name="create_date"/>
                <field name="store_id"/>
                <field name="operation"/>
                <field name="level" widget="badge"/>
                <field name="message"/>
                <field name="reference"/>
            </list>
        </field>
    </record>
    <record id="view_axsync_shopify_log_form" model="ir.ui.view">
        <field name="name">axsync.shopify.log.form</field>
        <field name="model">axsync.shopify.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <field name="store_id"/>
                        <field name="operation"/>
                        <field name="level"/>
                        <field name="reference"/>
                        <field name="message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_axsync_shopify_log_search" model="ir.ui.view">
        <field name="name">axsync.shopify.log.search</field>
        <field name="model">axsync.shopify.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="message"/>
                <field name="reference"/>
                <field name="operation"/>
                <filter name="errors" string="Errors" domain="[('level', '=', 'error')]"/>
                <filter name="warnings" string="Warnings" domain="[('level', '=', 'warning')]"/>
                
                    <filter name="g_store" string="Store" context="{'group_by': 'store_id'}"/>
                    <filter name="g_op" string="Operation" context="{'group_by': 'operation'}"/>
                    <filter name="g_level" string="Level" context="{'group_by': 'level'}"/>
                
            </search>
        </field>
    </record>
    <record id="action_axsync_shopify_log" model="ir.actions.act_window">
        <field name="name">Logs</field>
        <field name="res_model">axsync.shopify.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Products -->
    <record id="view_axsync_shopify_product_tree" model="ir.ui.view">
        <field name="name">axsync.shopify.product.tree</field>
        <field name="model">axsync.shopify.product</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'deleted'">
                <header>
                    <button name="action_export" string="Export" type="object"/>
                    <button name="action_publish" string="Publish" type="object"/>
                    <button name="action_unpublish" string="Unpublish" type="object"/>
                </header>
                <field name="name"/>
                <field name="store_id"/>
                <field name="template_id"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-info="state == 'draft'"/>
                <field name="variant_count"/>
                <field name="last_import"/>
                <field name="last_export"/>
            </list>
        </field>
    </record>
    <record id="view_axsync_shopify_product_form" model="ir.ui.view">
        <field name="name">axsync.shopify.product.form</field>
        <field name="model">axsync.shopify.product</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_export" string="Export to Shopify" type="object" class="btn-primary"/>
                    <button name="action_refresh" string="Refresh from Shopify" type="object" invisible="not shopify_id"/>
                    <button name="action_publish" string="Publish" type="object" invisible="state == 'active' or not shopify_id"/>
                    <button name="action_unpublish" string="Set to draft" type="object" invisible="state == 'draft' or not shopify_id"/>
                    <button name="action_archive_remote" string="Archive in Shopify" type="object" invisible="state == 'archived' or not shopify_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="store_id"/>
                            <field name="template_id"/>
                        </group>
                        <group>
                            <field name="shopify_id"/>
                            <field name="handle"/>
                            <field name="last_import"/>
                            <field name="last_export"/>
                        </group>
                    </group>
                    <group string="Last error" invisible="not last_error"><field name="last_error" nolabel="1"/></group>
                    <field name="variant_ids">
                        <list>
                            <field name="product_id"/>
                            <field name="sku"/>
                            <field name="barcode"/>
                            <field name="price"/>
                            <field name="compare_at_price"/>
                            <field name="shopify_id"/>
                            <field name="inventory_item_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_axsync_shopify_product_search" model="ir.ui.view">
        <field name="name">axsync.shopify.product.search</field>
        <field name="model">axsync.shopify.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="template_id"/>
                <field name="store_id"/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="errors" string="With error" domain="[('last_error', '!=', False)]"/>
                
                    <filter name="g_store" string="Store" context="{'group_by': 'store_id'}"/>
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                
            </search>
        </field>
    </record>
    <record id="action_axsync_shopify_product" model="ir.actions.act_window">
        <field name="name">Shopify products</field>
        <field name="res_model">axsync.shopify.product</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Customers -->
    <record id="view_axsync_shopify_customer_tree" model="ir.ui.view">
        <field name="name">axsync.shopify.customer.tree</field>
        <field name="model">axsync.shopify.customer</field>
        <field name="arch" type="xml">
            <list>
                <field name="email"/>
                <field name="partner_id"/>
                <field name="store_id"/>
                <field name="shopify_id"/>
                <field name="last_sync"/>
            </list>
        </field>
    </record>
    <record id="view_axsync_shopify_customer_search" model="ir.ui.view">
        <field name="name">axsync.shopify.customer.search</field>
        <field name="model">axsync.shopify.customer</field>
        <field name="arch" type="xml">
            <search>
                <field name="email"/>
                <field name="partner_id"/>
                <field name="store_id"/>
            </search>
        </field>
    </record>
    <record id="action_axsync_shopify_customer" model="ir.actions.act_window">
        <field name="name">Shopify customers</field>
        <field name="res_model">axsync.shopify.customer</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Abandoned checkouts -->
    <record id="view_axsync_shopify_checkout_tree" model="ir.ui.view">
        <field name="name">axsync.shopify.checkout.tree</field>
        <field name="model">axsync.shopify.checkout</field>
        <field name="arch" type="xml">
            <list decoration-success="recovered" decoration-muted="followed_up">
                <header>
                    <button name="action_create_activity" string="Create follow-up" type="object"/>
                </header>
                <field name="created_at"/>
                <field name="store_id"/>
                <field name="email"/>
                <field name="customer_name"/>
                <field name="total"/>
                <field name="currency"/>
                <field name="recovered"/>
                <field name="followed_up"/>
            </list>
        </field>
    </record>
    <record id="view_axsync_shopify_checkout_form" model="ir.ui.view">
        <field name="name">axsync.shopify.checkout.form</field>
        <field name="model">axsync.shopify.checkout</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_create_activity" string="Create follow-up activity" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="store_id"/>
                            <field name="email"/>
                            <field name="partner_id"/>
                            <field name="customer_name"/>
                        </group>
                        <group>
                            <field name="created_at"/>
                            <field name="total"/>
                            <field name="currency"/>
                            <field name="recovered"/>
                            <field name="followed_up"/>
                            <field name="url" widget="url"/>
                        </group>
                    </group>
                    <group string="Items"><field name="items" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_axsync_shopify_checkout_search" model="ir.ui.view">
        <field name="name">axsync.shopify.checkout.search</field>
        <field name="model">axsync.shopify.checkout</field>
        <field name="arch" type="xml">
            <search>
                <field name="email"/>
                <field name="customer_name"/>
                <filter name="open" string="Not recovered" domain="[('recovered', '=', False)]"/>
                <filter name="todo" string="To follow up" domain="[('recovered', '=', False), ('followed_up', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_axsync_shopify_checkout" model="ir.actions.act_window">
        <field name="name">Abandoned checkouts</field>
        <field name="res_model">axsync.shopify.checkout</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_todo': 1}</field>
    </record>

    <!-- Payouts -->
    <record id="view_axsync_shopify_payout_tree" model="ir.ui.view">
        <field name="name">axsync.shopify.payout.tree</field>
        <field name="model">axsync.shopify.payout</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="issued_at"/>
                <field name="store_id"/>
                <field name="statement_ref"/>
                <field name="status"/>
                <field name="gross" sum="Gross"/>
                <field name="fees" sum="Fees"/>
                <field name="refunds" sum="Refunds"/>
                <field name="net" sum="Net"/>
                <field name="currency"/>
            </list>
        </field>
    </record>
    <record id="action_axsync_shopify_payout" model="ir.actions.act_window">
        <field name="name">Payouts</field>
        <field name="res_model">axsync.shopify.payout</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Import one order -->
    <record id="view_axsync_shopify_import_order_form" model="ir.ui.view">
        <field name="name">axsync.shopify.import.order.form</field>
        <field name="model">axsync.shopify.import.order</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="store_id" options="{'no_create': True}"/>
                    <field name="order_name" placeholder="#1042"/>
                </group>
                <footer>
                    <button name="action_import" string="Import order" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_axsync_shopify_import_order" model="ir.actions.act_window">
        <field name="name">Import one order</field>
        <field name="res_model">axsync.shopify.import.order</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
